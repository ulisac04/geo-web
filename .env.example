VITE_API_URL=http://127.0.0.1:8080

# Google Cloud: Maps JavaScript API + Places API (New) + Directions API.
# Restringe la key por HTTP referrer (localhost:5173 y el dominio de prod).
VITE_GOOGLE_MAPS_API_KEY=

# Map ID vectorial (Cloud Console → Map Management). DEMO_MAP_ID basta para Advanced Markers en local.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
